    {
      "parameters": {
        "jsCode": "const labelMap = {\n  \"Label_2662191370750486781\": \"Inquiries\",\n  \"Label_5838584955535571894\": \"Applications\",\n  \"Label_862421246499623722\": \"Documents\"\n};\n\nreturn items.map(item => {\n  const labelIds = item.json.labelIds || [];\n  const matchingLabel = labelIds.find(id => labelMap[id]);\n\n  const email = item.json.from?.value?.[0];\n\n  const binaryKeys = Object.keys(item.binary || {});\n  const attachmentKey = binaryKeys[0];\n  const attachment = attachmentKey\n    ? item.binary[attachmentKey]\n    : null;\n\n  return {\n    json: {\n      messageId: item.json.id || \"\",\n      dateReceived: item.json.date || \"\",\n      senderName: email?.name || \"\",\n      senderEmail: email?.address || \"\",\n      subject: item.json.subject || \"\",\n      labelName: labelMap[matchingLabel] || \"\",\n      attachment: attachment?.fileName || \"\",\n      driveFolder: \"\",\n      status: \"Processed\",\n      processedAt: new Date().toISOString()\n    },\n    binary: item.binary\n  };\n});"
      },
      "id": "0cd6b354-ff5f-465f-bf1f-b64dcbe6acff",
